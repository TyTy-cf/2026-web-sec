{% extends 'front/base.html.twig' %}

{% block title %}{{ topic.title }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb" class="mt-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">{{ 'common.home'|trans }}</a></li>
            <li class="breadcrumb-item active">{{ topic.title }}</li>
        </ol>
    </nav>

    <article class="mb-4">
        <div class="d-flex justify-content-between align-items-start">
            <h1>{{ topic.title }}</h1>
            {% if app.user and app.user == topic.author %}
                <a href="{{ path('app_topic_edit', { id: topic.id }) }}" class="btn btn-sm btn-outline-secondary">{{ 'common.edit'|trans }}</a>
            {% endif %}
        </div>
        <p class="text-muted">
            <a href="{{ path('app_category_show', { id: topic.category.id }) }}">{{ topic.category.name }}</a> &middot; {{ 'common.posted_by'|trans({'%author%': topic.author.nickname, '%date%': topic.createdAt|date('d/m/Y H:i')}) }}
        </p>
        <p>{{ topic.content }}</p>
    </article>

    {% for flashMessage in app.flashes('success') %}
        <div class="alert alert-success">{{ flashMessage|trans }}</div>
    {% endfor %}

    <h2>{{ 'topic.comments_heading'|trans({'%count%': comments|length}) }}</h2>

    <ul class="list-group mb-4">
        {% for comment in comments %}
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div>
                    <strong>{{ comment.author.nickname }}</strong>
                    <span class="text-muted small">&mdash; {{ comment.createdAt|date('d/m/Y H:i') }}</span>
                    <div>{{ comment.content|raw }}</div>
                </div>
                {% if app.user and app.user == comment.author %}
                    <a href="{{ path('app_comment_delete', { id: comment.id }) }}" class="btn btn-sm btn-outline-danger">{{ 'common.delete'|trans }}</a>
                {% endif %}
            </li>
        {% else %}
            <li class="list-group-item">{{ 'topic.no_comments'|trans }}</li>
        {% endfor %}
    </ul>

    <h3>{{ 'topic.add_comment_heading'|trans }}</h3>
    {{ form_start(commentForm) }}
        {{ form_row(commentForm.content) }}
        {{ form_widget(commentForm.submit) }}
    {{ form_end(commentForm) }}
{% endblock %}
