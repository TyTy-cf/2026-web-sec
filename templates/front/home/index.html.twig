{% extends 'front/base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex align-items-center gap-3 my-4">
        <h1 class="mb-0">{{ 'home.latest_topics'|trans }}</h1>
        {% if app.user %}
            <a href="{{ path('app_topic_new') }}" class="btn btn-success">{{ 'home.new_topic'|trans }}</a>
        {% endif %}
    </div>

    {% for topic in topics %}
        <div class="card mb-3 col-xl-6 col-md-8 col-12 mx-auto">
            <div class="card-body">
                <h5 class="card-title">
                    <a href="{{ path('app_topic_show', { id: topic.id }) }}">{{ topic.title }}</a>
                </h5>
                <h6 class="card-subtitle mb-2 text-muted">
                    <a href="{{ path('app_category_show', { id: topic.category.id }) }}">{{ topic.category.name }}</a> &middot; {{ 'common.posted_by'|trans({'%author%': topic.author.nickname, '%date%': topic.createdAt|date('d/m/Y')}) }}
                </h6>
                <div class="d-flex">
                    <img class="img-fluid mx-auto" src="{{ topic.picture ~ '?r=' ~ topic.id }}" alt="Topic {{ topic.id }}">
                </div>
                <p class="card-text">
                    {{ topic.content|slice(0, 200) }}{% if topic.content|length > 200 %}&hellip;{% endif %}
                </p>
                <a href="{{ path('app_topic_show', { id: topic.id }) }}" class="btn btn-sm btn-outline-success">{{ 'common.view_topic'|trans }}</a>
            </div>
        </div>
    {% else %}
        <p>{{ 'home.no_topics'|trans }}</p>
    {% endfor %}
{% endblock %}
