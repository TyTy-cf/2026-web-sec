
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand ms-5" href="{{ path('app_home') }}">Reddit-Ish</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="{{ 'common.toggle_navigation'|trans }}">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <form class="d-flex mx-auto" method="get" action="{{ path('app_topic_search') }}">
            <div class="input-group">
                <input class="form-control" type="search" name="q"
                       {% if app.request.query.get('q') is not null %}value={{ app.request.query.get('q') }}{% endif %}
                       placeholder="{{ 'common.search_placeholder'|trans }}"
                       aria-label="{{ 'common.search'|trans }}">
                <button class="btn btn-outline-secondary" type="submit">{{ 'common.search'|trans }}</button>
            </div>
        </form>
        <div class="navbar-nav me-2">
            {% if app.user %}
                {{ 'common.logged_in_as'|trans }} <span class="text-muted mx-2">{{ app.user.nickname }}</span>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="me-2">
                        {{ 'common.back_office'|trans }}
                    </a>
                {% endif %}
                <a href="{{ path('app_logout') }}">
                    {{ 'common.logout'|trans }}
                </a>
            {% else %}
                <a href="{{ path('app_register') }}" class="me-2">
                    {{ 'common.register'|trans }}
                </a>
                <a href="{{ path('app_login') }}">
                    {{ 'common.login'|trans }}
                </a>
            {% endif %}
        </div>
    </div>
</nav>
